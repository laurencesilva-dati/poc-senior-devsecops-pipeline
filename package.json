{
  "name": "poc-erp-gestao-pessoas",
  "version": "1.0.0",
  "description": "POC - ERP de Gestão de Pessoas (aplicação propositalmente vulnerável para testes DevSecOps)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:ci": "jest --coverage --coverageReporters=lcov --coverageReporters=text --forceExit",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "ejs": "^3.1.9",
    "body-parser": "^1.20.2",
    "express-session": "^1.17.3",
    "dotenv": "^16.3.1",
    "md5": "^2.3.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "sonarqube-scanner": "^3.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
