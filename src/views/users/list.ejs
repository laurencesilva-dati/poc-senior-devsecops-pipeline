<!DOCTYPE html>
<html>
<head>
  <title>ERP - Usuários</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; background: #f0f2f5; }
    .container { max-width: 1200px; margin: 0 auto; }
    nav { background: #001529; padding: 15px 20px; border-radius: 4px; margin-bottom: 20px; }
    nav a { color: white; text-decoration: none; margin-right: 20px; }
    nav a:hover { color: #1890ff; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 4px; overflow: hidden; }
    th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; }
    th { background: #fafafa; font-weight: 600; }
    .btn { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 13px; }
    .btn-primary { background: #1890ff; color: white; }
    .btn-danger { background: #ff4d4f; color: white; }
    .btn-success { background: #52c41a; color: white; }
    h1 { color: #333; }
  </style>
</head>
<body>
  <div class="container">
    <nav>
      <a href="/users">Usuários</a>
      <a href="/departments">Departamentos</a>
      <a href="/vacations">Férias</a>
      <a href="/logout" style="float:right">Sair (<%= currentUser.username %>)</a>
    </nav>
    <h1>Gestão de Usuários</h1>
    <a href="/users/new" class="btn btn-primary" style="margin-bottom:15px;display:inline-block">+ Novo Usuário</a>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Username</th>
          <th>Email</th>
          <th>Departamento</th>
          <th>Role</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
        <tr>
          <td><%= user.id %></td>
          <!-- Vulnerabilidade: XSS - output não sanitizado -->
          <td><%- user.full_name %></td>
          <td><%= user.username %></td>
          <td><%= user.email %></td>
          <td><%= user.department_name || '-' %></td>
          <td><%= user.role %></td>
          <td>
            <a href="/users/<%= user.id %>" class="btn btn-primary">Ver</a>
            <form method="POST" action="/users/<%= user.id %>/delete" style="display:inline">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza?')">Excluir</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
